{
  "manifest_version": 3,
  "name": "nabnab",
  "version": "0.2.0",
  "description": "Envía enlaces a nabnab para descargarlos en tu ordenador.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1:49587/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Enviar a nabnab" },
  "options_page": "options.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
